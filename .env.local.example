# Kopiere diese Datei zu ".env.local" und trage die Werte aus dem Supabase-Projekt ein
# (Project Settings -> API). ".env.local" wird nicht eingecheckt (siehe .gitignore, *.local).
#
# Nutzt bewusst dasselbe Supabase-Projekt wie die Gym App (eigene, per RLS getrennte
# Tabellen mit "notiz_"-Prefix), um kein weiteres kostenloses Projekt zu brauchen.
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
